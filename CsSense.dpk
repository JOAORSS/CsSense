package CsSense;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  designide,
  dbrtl,
  vclFireDAC,
  FireDAC,
  FireDACCommonDriver,
  FireDACCommon,
  FireDACSqliteDriver;

contains
  ExtratorUnit in 'ExtratorUnit.pas',
  EditorPopupForm in 'EditorPopupForm.pas',
  FileWatcherNotifier in 'FileWatcherNotifier.pas',
  SymbolIndex in 'SymbolIndex.pas',
  SQLiteEngine in 'SQLiteEngine.pas',
  SymbolTypes in 'SymbolTypes.pas',
  BackgroundIndexer in 'BackgroundIndexer.pas',
  ConfigManager in 'ConfigManager.pas',
  GoToDefinition in 'GoToDefinition.pas';


end.
